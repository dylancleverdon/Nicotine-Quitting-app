<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Firewatch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fw_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ splash: the flame, with "by Baastik Labs" underneath. -->
    <style name="Theme.Firewatch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fw_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Firewatch</item>
    </style>
</resources>
